# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database — DreamNexa runs on MySQL. Either set the discrete DB_* vars
# below, or set DATABASE_URL to a full mysql:// connection string (it
# takes priority over the discrete vars if both are set).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dreamnexa
DB_USER=root
# IMPORTANT: if your password contains a `#`, wrap it in double quotes —
# dotenv treats an unquoted `#` as the start of a comment and will
# silently truncate the value otherwise.
DB_PASSWORD="Gangadhar#14"
# DATABASE_URL=mysql://root:Gangadhar%2314@localhost:3306/dreamnexa
DB_POOL_SIZE=10

# News: managed via admin panel — no external API keys needed

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Points economy (NOT real money — purely in-app gamification units)
DAILY_LOGIN_POINTS=10
REFERRAL_BONUS_POINTS=100

# NOTE: There is intentionally no payment gateway or cash-withdrawal
# configuration in this project. Contest entry is always free. Prizes are
# non-monetary (badges, points, sponsor-funded vouchers fulfilled manually
# by admins outside the app) — see README.md "Rewards Policy".

# AI Quiz Proctor (webcam/tab-switch monitoring during contests)
# Set to 'false' to disable proctoring platform-wide regardless of each
# quiz's own proctoring_enabled flag.
PROCTORING_ENABLED=true

# Production note: on Google Cloud Run, set CLIENT_URL, the DB_* vars
# (or DATABASE_URL / INSTANCE_CONNECTION_NAME) pointing at Cloud SQL,
# JWT_ACCESS_SECRET, and JWT_REFRESH_SECRET in the service environment
# variables.
