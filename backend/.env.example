# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://quizarena_user:quizarena_pass@localhost:5432/quizarena

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Points economy (NOT real money — purely in-app gamification units)
DAILY_LOGIN_POINTS=10
REFERRAL_BONUS_POINTS=100

# NOTE: There is intentionally no payment gateway, wallet, or cash-withdrawal
# configuration in this project. Contest entry is always free. Prizes are
# non-monetary (badges, points, sponsor-funded vouchers fulfilled manually
# by admins outside the app) — see README.md "Rewards Policy".
